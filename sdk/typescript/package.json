{
  "name": "leashbyte",
  "version": "0.1.2",
  "description": "TypeScript client for the LeashByte API",
  "license": "Apache-2.0",
  "homepage": "https://leashbyte.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangybyte/leashbyte.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/mangybyte/leashbyte/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "licenses": "node scripts/licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "license-checker": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
