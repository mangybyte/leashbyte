# Copy this file to .env and give each of the eight secrets below its own random value.
# openssl rand -hex 32 generates a suitable one.
LEASHBYTE_API_KEY=replace-with-a-random-api-key
LEASHBYTE_SEARXNG_SECRET_KEY=replace-with-a-different-random-secret
LEASHBYTE_SERVICE_KEY=replace-with-a-random-service-key
LEASHBYTE_VAULT_MANAGE_KEY=replace-with-a-random-vault-manage-key
LEASHBYTE_VAULT_RESOLVE_KEY=replace-with-a-random-vault-resolve-key
LEASHBYTE_CDP_KEY=replace-with-a-random-cdp-capability-key
LEASHBYTE_VAULT_MASTER_KEY=replace-with-a-random-vault-master-key
LEASHBYTE_POSTGRES_PASSWORD=replace-with-a-random-postgres-password

LEASHBYTE_BIND_ADDRESS=127.0.0.1
LEASHBYTE_PORT=8080
LEASHBYTE_MCP_BIND_ADDRESS=127.0.0.1
LEASHBYTE_MCP_PORT=8081
LEASHBYTE_SEARXNG_BASE_URL=http://searxng:8080
LEASHBYTE_BROWSER_POOL_BASE_URL=http://browser-pool:8082
LEASHBYTE_VAULT_BASE_URL=http://vault:8081
LEASHBYTE_FETCH_TIMEOUT_SECONDS=20
LEASHBYTE_FETCH_MAX_BYTES=2000000
LEASHBYTE_FETCH_MAX_REDIRECTS=5
LEASHBYTE_SEARCH_MAX_RESULTS=10
LEASHBYTE_PRIVATE_NETWORK_ALLOWLIST=
LEASHBYTE_BROWSER_MAX_SESSIONS=2
LEASHBYTE_BROWSER_LEASE_SECONDS=900
LEASHBYTE_CDP_GRANT_SECONDS=60
LEASHBYTE_BROWSER_PLUGINS_ENABLED=false
LEASHBYTE_BROWSER_PLUGIN_MODULES=
LEASHBYTE_LOCAL_MODEL_BASE_URL=
LEASHBYTE_COMPOSE_SUBNET=172.29.250.0/24
LEASHBYTE_COMPOSE_GATEWAY=172.29.250.1
LEASHBYTE_LOCAL_MODEL_PORT=11434
# Needed for local agent runs: the model name your server exposes.
LEASHBYTE_LOCAL_MODEL_NAME=
LEASHBYTE_LOCAL_MODEL_API_KEY=
LEASHBYTE_LOCAL_MODEL_API_KEY_FILE=
LEASHBYTE_MODEL_TIMEOUT_SECONDS=120
LEASHBYTE_AGENT_POLL_SECONDS=0.5
# Optional: path to an Anthropic API key file (mode 600) outside this repository.
# Leave it empty if you only use local models.
LEASHBYTE_ANTHROPIC_API_KEY_HOST_FILE=
LEASHBYTE_WEB_BOT_AUTH_KEY_FILE=
LEASHBYTE_WEB_BOT_AUTH_HOST_KEY_FILE=
LEASHBYTE_WEB_BOT_AUTH_KEY_ID=
# Optional, for a controlled private HTTPS test fixture only: its SHA-256 SPKI value.
LEASHBYTE_BROWSER_TLS_SPKI_ALLOWLIST=
